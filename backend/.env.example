# MySQL is the only supported database backend.
DB_ENGINE=mysql

# Generate a unique value for backend/.env. Never commit that file.
SECRET_KEY=generate-a-unique-secret-key-before-running
DEBUG=True

# MySQL connection settings
DB_NAME=pet_vaccination_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email OTP settings. For Gmail, use a Google App Password (not your account
# password) and replace these values in backend/.env only.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your_google_app_password
DEFAULT_FROM_EMAIL=you@example.com
